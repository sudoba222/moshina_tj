# ── Core ────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@host/tajcar
SECRET_KEY=                         # generate: python -c "import secrets; print(secrets.token_hex(32))"
ENVIRONMENT=production              # "production" | "development"

# ── CORS & URLs ─────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://tajcar.tj,https://www.tajcar.tj
FRONTEND_URL=https://tajcar.tj
GOOGLE_REDIRECT_URI=https://api.tajcar.tj/api/v1/auth/google/callback

# ── Image Storage (Cloudinary) ───────────────────────────────────────────────
# Required in production — without these, image uploads return HTTP 503.
# Sign up free at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Staff accounts ───────────────────────────────────────────────────────────
# REQUIRED: staff accounts are not seeded until this is set.
# Use a strong password and change it immediately after first login.
STAFF_DEFAULT_PASSWORD=
ADMIN_PHONE=+992900000003
MODERATOR_PHONE=+992900000004
MANAGER_PHONE=+992900000005
SUPPORT_PHONE=+992900000006

# ── Email (Resend) ───────────────────────────────────────────────────────────
# Free tier: 3,000 emails/month. Sign up at https://resend.com
# IMPORTANT: verify tajcar.tj domain in Resend dashboard → Domains → Add Domain
RESEND_API_KEY=re_4nBKG55d_AnnhzojzGLuHKdVSyZtUH1UQ
RESEND_FROM_EMAIL=TajCar.tj <noreply@tajcar.tj>

# ── SMS (Twilio) ─────────────────────────────────────────────────────────────
# Required for phone OTP. Leave empty → codes logged to stdout (dev only).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# ── Telegram bot ─────────────────────────────────────────────────────────────
# 1. Create bot via @BotFather → copy token
# 2. After deploying, register webhook:
#    curl "https://api.telegram.org/bot<TOKEN>/setWebhook" \
#         -d "url=https://api.tajcar.tj/api/v1/telegram/webhook" \
#         -d "secret_token=<WEBHOOK_SECRET>"
# Generate WEBHOOK_SECRET: python -c "import secrets; print(secrets.token_hex(32))"
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=your_bot_username
TELEGRAM_WEBHOOK_SECRET=

# ── Google OAuth ─────────────────────────────────────────────────────────────
# console.cloud.google.com → Credentials → OAuth 2.0 Client ID
# Authorized redirect URIs: https://api.tajcar.tj/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Apple Sign In ────────────────────────────────────────────────────────────
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# ── AI description refinement (optional) ─────────────────────────────────────
# Leave empty to disable the "Improve with AI" button
ANTHROPIC_API_KEY=
